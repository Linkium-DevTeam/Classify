<Window x:Class="Classify.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classify — 教师喊话 · 文件快传"
        Width="1000" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="Manual"
        Background="{StaticResource BrushBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边导航 -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurface}">
            <DockPanel Margin="12,16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,18">
                        <Image x:Name="BrandLogo" Width="34" Height="34" Stretch="Uniform"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Classify" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
                            <TextBlock Text="教室课堂助手" FontSize="10.5" Foreground="{StaticResource BrushSub}"/>
                        </StackPanel>
                    </StackPanel>

                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav"
                                 Checked="Nav_Checked" Tag="home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="首页" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav"
                                 Checked="Nav_Checked" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="nav"
                                 Checked="Nav_Checked" Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💎" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="关于" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,4">
                    <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource BrushSub}"
                               TextWrapping="Wrap" Text="初始化…"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- 内容 -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="24,20,24,16"/>
    </Grid>
</Window>
