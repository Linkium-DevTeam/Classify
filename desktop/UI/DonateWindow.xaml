<Window x:Class="Classify.UI.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classify · 支持开发者" Width="780" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{StaticResource BrushBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="支持开发者" Style="{StaticResource TDisplay}" FontSize="26"/>
            <TextBlock Style="{StaticResource TBody}" Margin="0,8,0,0" Opacity="0.85" MaxWidth="700"
                       TextWrapping="Wrap"
                       Text="Classify 由 Linkium DevTeam 用爱发电、免费提供。如果它让你的课堂更省心，欢迎请作者喝一杯奶茶 ☕（扫码后备注昵称）"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="支付宝" Style="{StaticResource TTitle}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                    <Image x:Name="AlipayImg" Height="330" Stretch="Uniform"/>
                    <TextBlock Text="支付宝：Linkium-suki" Style="{StaticResource TCaption}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="微信" Style="{StaticResource TTitle}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                    <Image x:Name="WechatImg" Height="330" Stretch="Uniform"/>
                    <TextBlock Text="微信：长安不洛雪" Style="{StaticResource TCaption}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Button Grid.Row="2" Style="{StaticResource BtnTonal}" Content="关闭" Margin="0,14,0,0"
                HorizontalAlignment="Center" Click="CloseBtn_Click"/>
    </Grid>
</Window>
