<Window x:Class="Classify.UI.QrBindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classify — 邀请教师绑定" Width="400" Height="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BrushBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji">
    <StackPanel Margin="30,26">
        <TextBlock Text="邀请教师绑定" Style="{StaticResource TTitle}" HorizontalAlignment="Center"/>
        <TextBlock Text="教师在手机端「设备 → 扫一扫」扫描即可关联本机（多教师共享同一台教室电脑）"
                   Style="{StaticResource TCaption}" TextAlignment="Center" Margin="0,8,0,16"/>
        <Border Style="{StaticResource Card}">
            <StackPanel HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="250" Height="250" Stretch="Uniform"/>
                <TextBlock x:Name="StatusText" Text="正在生成二维码…" Style="{StaticResource TBody}"
                           TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="CountdownText" Text="" Style="{StaticResource TCaption}"
                           TextAlignment="Center" Margin="0,6,0,0"/>
                <Button x:Name="RefreshBtn" Style="{StaticResource BtnSmall}" Content="刷新二维码"
                        Margin="0,10,0,0" HorizontalAlignment="Center" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
