<UserControl x:Class="Classify.UI.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="运行状态" Style="{StaticResource TTitle}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                             Fill="{StaticResource BrushOk}" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CloudText" Style="{StaticResource TBody}" Text="未配置云端"/>
                        <TextBlock x:Name="ClassText" Style="{StaticResource TCaption}" Margin="0,3,0,0"
                                   Text="未检测到全屏课件"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnTonal}" Content="测试喊话"
                            VerticalAlignment="Center" Click="TestBtn_Click"/>
                </Grid>
            </Border>

            <TextBlock Text="最近动态" Style="{StaticResource TSection}"/>
            <Border Style="{StaticResource Card}" Padding="8">
                <StackPanel>
                    <TextBlock x:Name="EmptyHint" Text="暂无动态。教师在手机端发送喊话 / 文件 / 指令后会显示在这里。"
                               Style="{StaticResource TCaption}" Margin="10,8"/>
                    <ItemsControl x:Name="ActivityList" ItemsSource="{Binding Activities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TBody}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource TCaption}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="快捷操作" Style="{StaticResource TSection}"/>
            <WrapPanel>
                <Button x:Name="InviteBtn" Style="{StaticResource BtnPrimary}" Margin="0,0,10,10"
                        Content="📱 邀请教师扫码绑定" Click="InviteBtn_Click"/>
                <Button x:Name="CopyUrlBtn" Style="{StaticResource BtnTonal}" Margin="0,0,10,10"
                        Content="📋 复制手机端地址" Click="CopyUrlBtn_Click"/>
                <Button x:Name="WizardBtn" Style="{StaticResource BtnTonal}" Margin="0,0,10,10"
                        Content="🧭 重新运行配置向导" Click="WizardBtn_Click"/>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
