<Window x:Class="Classify.UI.ClassPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classify 喊话" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="Height" MaxHeight="360"
        Background="Transparent" Cursor="Hand">
    <Border x:Name="Root" Background="#F2111626" CornerRadius="18" Padding="30,22"
            BorderBrush="#334655D6" BorderThickness="1"
            MouseDown="Root_Tapped">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📢" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock x:Name="FromText" Text="课堂通知" FontSize="14" Foreground="#FF9AA3BC"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MainText" Text="" FontSize="30" FontWeight="SemiBold" Foreground="White"
                       TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="42"
                       FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="SpeakingPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="🔊 正在朗读" FontSize="12.5" Foreground="#FF7C8CFF"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Grid.Column="1" Text="" FontSize="12" Foreground="#FF6B7694"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
