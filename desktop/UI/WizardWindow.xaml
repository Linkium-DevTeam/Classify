<Window x:Class="Classify.UI.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classify — 首次配置" Width="800" Height="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BrushBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji">
    <Grid Margin="36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="欢迎使用 Classify" Style="{StaticResource TDisplay}"/>
            <TextBlock x:Name="StepTitle" Text="第 1 步 / 共 4 步 · 用户协议与隐私政策"
                       Style="{StaticResource TCaption}" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Ellipse x:Name="Dot0" Width="9" Height="9" Fill="{StaticResource BrushAccent}" Margin="0,0,7,0"/>
                <Ellipse x:Name="Dot1" Width="9" Height="9" Fill="{StaticResource BrushAccent}" Opacity="0.35" Margin="0,0,7,0"/>
                <Ellipse x:Name="Dot2" Width="9" Height="9" Fill="{StaticResource BrushAccent}" Opacity="0.35" Margin="0,0,7,0"/>
                <Ellipse x:Name="Dot3" Width="9" Height="9" Fill="{StaticResource BrushAccent}" Opacity="0.35"/>
            </StackPanel>
        </StackPanel>

        <!-- 步骤内容 -->
        <Grid Grid.Row="1">
            <!-- Step 0：协议 -->
            <StackPanel x:Name="Step0">
                <Border Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Padding="16">
                        <TextBlock x:Name="AgreementText" Style="{StaticResource TBody}" FontSize="12.5" LineHeight="20"/>
                    </ScrollViewer>
                </Border>
                <CheckBox x:Name="AgreeCheck" Style="{StaticResource Check}" Margin="4,14,0,0"
                          Content="我已阅读并同意《用户协议》与《隐私政策》" Checked="AgreeCheck_Changed" Unchecked="AgreeCheck_Changed"/>
            </StackPanel>

            <!-- Step 1：连接方式 -->
            <StackPanel x:Name="Step1" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="连接云端" Style="{StaticResource TTitle}"/>
                        <TextBlock Style="{StaticResource TBody}" Margin="0,8,0,0"
                                   Text="Classify 通过 Linkium DevTeam 云端中继（ccall.linkium.top）连接你的手机。"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,6,0,14"
                                   Text="同一台教室电脑可被多位教师绑定；所有数据按教师账号隔离。"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" MaxLength="32"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,6,0,0"
                                   Text="设备名称（显示在教师手机端的设备列表里）"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 2：扫码绑定 + 手动配对 -->
            <Grid x:Name="Step2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel HorizontalAlignment="Center">
                            <Image x:Name="QrImage" Width="240" Height="240" Stretch="Uniform"/>
                            <TextBlock x:Name="BindStatus" Text="正在生成绑定二维码…" Style="{StaticResource TBody}"
                                       TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="QrCountdown" Text="" Style="{StaticResource TCaption}"
                                       TextAlignment="Center" Margin="0,6,0,0"/>
                            <Button x:Name="RefreshQrBtn" Style="{StaticResource BtnSmall}" Content="刷新二维码"
                                    Margin="0,10,0,0" HorizontalAlignment="Center" Click="RefreshQrBtn_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="手机扫码确认" Style="{StaticResource TTitle}"/>
                            <TextBlock Style="{StaticResource TBody}" Margin="0,8,0,0"
                                       Text="用手机浏览器打开 ccall.linkium.top 并登录，在「设备」页点「扫一扫」扫描左侧二维码，再点「确认绑定」。"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ManualToggleBtn" Style="{StaticResource BtnGhost}" Content="无法扫码？手动输入配对码 →"
                            HorizontalAlignment="Left" Margin="4,6,0,0" Click="ManualToggleBtn_Click"/>
                    <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Margin="4,8,0,0">
                        <TextBox x:Name="CodeBox" Style="{StaticResource InputBox}" MaxLength="6"
                                 FontSize="22" HorizontalContentAlignment="Center" Padding="9,10"/>
                        <Button x:Name="ConnectBtn" Style="{StaticResource BtnPrimary}" Content="绑定"
                                Margin="0,12,0,0" Click="ConnectBtn_Click"/>
                        <TextBlock x:Name="ConnectHint" Style="{StaticResource TCaption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Step 3：完成配置 -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="开机自启" Style="{StaticResource TTitle}"/>
                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                  Content="开机自动运行（静默驻留托盘）"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,8,0,0"
                                   Text="开机后不弹窗口；进程被结束后伴生看护会自动恢复。"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="系统控制" Style="{StaticResource TTitle}"/>
                        <CheckBox x:Name="AllowPowerCheck" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                  Content="允许教师远程关机 / 重启（高危，默认关闭）"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,8,0,0"
                                   Text="音量、锁屏、熄屏等基础控制在设置页可随时调整。"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="语音试听" Style="{StaticResource TTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource BtnTonal}" Content="🔊 试听朗读" Click="TtsTryBtn_Click"/>
                            <Button Style="{StaticResource BtnTonal}" Content="📢 大屏测试喊话" Margin="10,0,0,0" Click="TestAnnounceBtn_Click"/>
                            <TextBlock Style="{StaticResource TCaption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="Azure 神经语音可在设置页配置（默认本地引擎）。"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BackBtn" Style="{StaticResource BtnTonal}" Content="上一步"
                    Click="BackBtn_Click" Visibility="Collapsed"/>
            <Button x:Name="NextBtn" Style="{StaticResource BtnPrimary}" Content="开始配置"
                    Margin="10,0,0,0" Click="NextBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
