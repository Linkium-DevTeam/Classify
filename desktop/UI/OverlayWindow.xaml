<Window x:Class="Classify.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classify 喊话" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FF0B1020" Cursor="Hand">
    <Grid x:Name="Root" Background="#FF0B1020" MouseDown="Root_Tapped">
        <Image x:Name="WallpaperImg" Stretch="UniformToFill" Opacity="0.35"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60,0">
            <TextBlock Text="📢" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,26"/>
            <TextBlock x:Name="MainText" Text="" FontSize="56" FontWeight="Bold" Foreground="White"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="76"
                       FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji"
                       MaxWidth="1500" HorizontalAlignment="Center"/>
            <TextBlock x:Name="FromText" Text="课堂通知" FontSize="19" Foreground="#FF9AA3BC"
                       HorizontalAlignment="Center" Margin="0,28,0,0"/>
            <StackPanel x:Name="SpeakingPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,22,0,0" Visibility="Collapsed">
                <TextBlock Text="🔊 正在朗读" FontSize="15" Foreground="#FF7C8CFF"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="HintText" Text="" FontSize="13" Foreground="#FF6B7694"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"/>
        <Button x:Name="CloseBtn" Content="✕" Width="44" Height="44" FontSize="17"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
                Background="#22FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"
                Click="CloseBtn_Click"/>
    </Grid>
</Window>
