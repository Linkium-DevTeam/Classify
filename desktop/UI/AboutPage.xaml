<UserControl x:Class="Classify.UI.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="BrandLogo" Width="52" Height="52" Stretch="Uniform"/>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Classify" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
                            <TextBlock x:Name="VersionText" Text="版本" Style="{StaticResource TCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource TBody}" Margin="0,14,0,0"
                               Text="教师喊话 · 文件快传 · 课堂助手。面向教室一体机（适配希沃交互式一体机等场景），由教师在手机上远程向大屏发送喊话、文件与时钟、看板等课堂表面。"/>
                    <TextBlock Style="{StaticResource TCaption}" Margin="0,8,0,0"
                               Text="v3 起基于 WPF / .NET 10 重建：更小体积、更稳的托盘与全屏表面、不再依赖 WinUI。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="社区" Style="{StaticResource TSection}" Margin="0"/>
                    <TextBlock Style="{StaticResource TBody}" Text="贡献者（GitHub）"/>
                    <TextBlock x:Name="ContributorsText" Style="{StaticResource TCaption}" Margin="0,4,0,0" Text="加载中…"/>
                    <TextBlock Style="{StaticResource TBody}" Margin="0,12,0,0" Text="捐助者"/>
                    <TextBlock x:Name="DonorsText" Style="{StaticResource TCaption}" Margin="0,4,0,0"
                               Text="名单维护于爱发电主页 · 期待你的名字"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnTonal}" Margin="0,0,10,0" Content="❤ 在爱发电支持" Click="AfdianBtn_Click"/>
                        <Button Style="{StaticResource BtnTonal}" Content="⭐ 开源仓库" Click="RepoBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Opacity="0.75">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="DevLogo" Width="26" Height="26" Stretch="Uniform"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Linkium DevTeam" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                        <TextBlock Text="© 2026 · Apache 2.0 开源 · EasiCareHelper 为闭源组件" Style="{StaticResource TCaption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,4,0,0">
                <Button Style="{StaticResource BtnTonal}" Margin="0,0,10,10" Content="用户协议" Click="AgreementBtn_Click"/>
                <Button Style="{StaticResource BtnTonal}" Margin="0,0,10,10" Content="隐私政策" Click="PrivacyBtn_Click"/>
                <Button Style="{StaticResource BtnTonal}" Margin="0,0,10,10" Content="💬 反馈问题" Click="FeedbackBtn_Click"/>
                
                <Button Style="{StaticResource BtnTonal}" Margin="0,0,10,10" Content="打开日志目录" Click="LogsBtn_Click"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource TCaption}" Margin="0,6,0,0"
                       Text="问题反馈：应用内提交，或邮件 support@linkium.top（附版本号与现象描述可加快定位）"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
